# Optional build-time history password. Client-side bundles expose this value.
# Without it, the app asks you to set a local password on first use.
EXPO_PUBLIC_HISTORY_PASSWORD=

# Native/local development API origin. Deployed web uses the same-origin Worker proxy.
# Never put DB passwords or admin credentials here.
EXPO_PUBLIC_API_URL=https://easyq-api.findingai.top
# Optional: use "direct" only for hosting without the Worker proxy (e.g. Pages).
# Leave empty for the default same-origin API mode on production web.
EXPO_PUBLIC_API_MODE=
EXPO_PUBLIC_SITE_AUTHOR=EasyQ
